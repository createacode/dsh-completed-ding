{
  "name": "dsh-completed-ding",
  "version": "1.0.0",
  "private": true,
  "description": "A warm honey-toned bottom-right alert for completed, failed, or waiting-for-answer sessions, with accurate failure reasons, bundled or custom audio, and workspace folder opening.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "sounds/*.mp3"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "license": "AGPL-3.0"
}
