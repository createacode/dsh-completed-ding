{
  "name": "dsh-completed-ding",
  "version": "1.5.4",
  "private": true,
  "description": "A warm bottom-right alert for completed, failed, or waiting-for-answer sessions, switchable between in-app cards, desktop notifications, and a floating window, with audio, workspace opening, and one-click or daily automatic Gitee updates.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "sounds/*.mp3"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "license": "AGPL-3.0"
}
